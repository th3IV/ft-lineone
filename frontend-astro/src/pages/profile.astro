---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Mi Perfil - FT. THE LINE ONE">
  <div class="min-h-screen bg-editorial-cream">
    <header class="bg-editorial-white border-b border-editorial-cream-dark sticky top-0 z-40">
      <div class="container-main py-4">
        <h1 class="font-display text-2xl font-semibold text-editorial-black">Mi Perfil</h1>
      </div>
    </header>

    <div class="container-main py-8">
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Profile Sidebar -->
        <aside class="lg:w-64 flex-shrink-0">
          <div class="bg-editorial-white rounded-2xl border border-editorial-cream-dark p-6">
            <div class="text-center mb-6">
              <div class="w-24 h-24 mx-auto mb-4 rounded-full bg-editorial-cream-dark overflow-hidden">
                <img id="profile-image" src="" alt="Perfil" class="w-full h-full object-cover hidden" />
                <div id="avatar-placeholder" class="w-full h-full flex items-center justify-center">
                  <svg class="w-10 h-10 text-editorial-gray" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h18a7 7 0 00-7-7z" />
                  </svg>
                </div>
              </div>
              <h2 id="profile-name" class="font-display text-xl font-semibold text-editorial-black">Usuario</h2>
              <p id="profile-email" class="text-sm text-editorial-gray">usuario@email.com</p>
              <div class="mt-3">
                <span id="plan-badge" class="px-3 py-1 text-xs font-medium rounded-full bg-editorial-cream-dark text-editorial-gray">
                  Plan Free
                </span>
              </div>
            </div>

            <div class="space-y-2">
              <button id="btn-vton" class="w-full btn-primary text-sm py-2">
                Probar VTON
              </button>
              <button id="btn-catalog" class="w-full btn-secondary text-sm py-2">
                Ver Catálogo
              </button>
              <button id="btn-chat" class="w-full btn-outline text-sm py-2">
                Asesor IA
              </button>
            </div>
          </div>

          <!-- Account Info -->
          <div class="bg-editorial-white rounded-2xl border border-editorial-cream-dark p-6 mt-6">
            <h3 class="font-display text-lg font-semibold text-editorial-black mb-4 pb-2 border-b border-editorial-cream-dark">
              Información de cuenta
            </h3>
            <dl class="space-y-3 text-sm">
              <div class="flex justify-between">
                <dt class="text-editorial-gray">Email</dt>
                <dd id="account-email" class="text-editorial-black font-medium">usuario@email.com</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-editorial-gray">Plan</dt>
                <dd id="account-plan" class="text-editorial-black font-medium">Free</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-editorial-gray">Usos VTON hoy</dt>
                <dd id="usage-vton" class="text-editorial-black font-medium">0/5</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-editorial-gray">Mensajes IA hoy</dt>
                <dd id="usage-llm" class="text-editorial-black font-medium">0/5</dd>
              </div>
            </dl>
          </div>
        </aside>

        <!-- Main Content Tabs -->
        <main class="flex-1">
          <div class="bg-editorial-white rounded-2xl border border-editorial-cream-dark overflow-hidden">
            <nav class="flex border-b border-editorial-cream-dark" aria-label="Tabs">
              <button data-tab="profile" class="tab-btn px-6 py-4 font-medium text-sm text-editorial-gold border-b-2 border-editorial-gold">
                Perfil
              </button>
              <button data-tab="measurements" class="tab-btn px-6 py-4 font-medium text-sm text-editorial-gray hover:text-editorial-black border-b-2 border-transparent hover:border-editorial-cream-dark">
                Medidas
              </button>
              <button data-tab="preferences" class="tab-btn px-6 py-4 font-medium text-sm text-editorial-gray hover:text-editorial-black hover:border-editorial-cream-dark">
                Preferencias
              </button>
              <button data-tab="history" class="tab-btn px-6 py-4 font-medium text-sm text-editorial-gray hover:text-editorial-black hover:border-editorial-cream-dark">
                Historial VTON
              </button>
              <button data-tab="favorites" class="tab-btn px-6 py-4 font-medium text-sm text-editorial-gray hover:text-editorial-black hover:border-editorial-cream-dark">
                Favoritos
              </button>
              <button data-tab="subscription" class="tab-btn px-6 py-4 font-medium text-sm text-editorial-gray hover:text-editorial-black hover:border-editorial-cream-dark">
                Suscripción
              </button>
            </nav>

            <div class="p-6">
              <!-- Profile Tab -->
              <div id="tab-profile" class="tab-content space-y-6">
                <div class="grid md:grid-cols-2 gap-6">
                  <div>
                    <label class="block text-sm font-medium text-editorial-gray mb-2">Nombre</label>
                    <input type="text" id="input-name" class="w-full px-4 py-3 text-editorial-black bg-editorial-white border border-editorial-cream-dark focus:outline-none focus:ring-2 focus:ring-editorial-gold focus:border-editorial-gold transition-colors" />
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-editorial-gray mb-2">Email</label>
                    <input type="email" id="input-email" class="w-full px-4 py-3 text-editorial-black bg-editorial-white border border-editorial-cream-dark focus:outline-none focus:ring-2 focus:ring-editorial-gold focus:border-editorial-gold transition-colors" disabled />
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-editorial-gray mb-2">Género</label>
                    <select id="input-gender" class="w-full px-4 py-3 text-editorial-black bg-editorial-white border border-editorial-cream-dark focus:outline-none focus:ring-2 focus:ring-editorial-gold focus:border-editorial-gold transition-colors">
                      <option value="">Seleccionar</option>
                      <option value="mujer">Mujer</option>
                      <option value="hombre">Hombre</option>
                      <option value="unisex">Unisex</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-editorial-gray mb-2">Edad</label>
                    <input type="number" id="input-age" min="13" max="100" class="w-full px-4 py-3 text-editorial-black bg-editorial-white border border-editorial-cream-dark focus:outline-none focus:ring-2 focus:ring-editorial-gold focus:border-editorial-gold transition-colors" />
                  </div>
                </div>
                <div class="flex justify-end gap-3 pt-4 border-t border-editorial-cream-dark">
                  <button id="btn-cancel-profile" class="btn-secondary">Cancelar</button>
                  <button id="btn-save-profile" class="btn-primary">Guardar cambios</button>
                </div>
              </div>

              <div id="tab-measurements" class="tab-content hidden space-y-6">
                <h3 class="font-display text-lg font-semibold text-editorial-black">Medidas corporales (cm)</h3>
                <p class="text-editorial-gray text-sm">Estas medidas ayudan a que el VTON se ajuste mejor a tu cuerpo.</p>
                <div class="grid md:grid-cols-2 gap-6">
                  <div>
                    <label class="block text-sm font-medium text-editorial-gray mb-2">Altura (cm)</label>
                    <input type="number" id="m-height" min="100" max="250" class="w-full px-4 py-3 text-editorial-black bg-editorial-white border border-editorial-cream-dark focus:outline-none focus:ring-2 focus:ring-editorial-gold focus:border-editorial-gold transition-colors" />
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-editorial-gray mb-2">Peso (kg)</label>
                    <input type="number" id="m-weight" min="30" max="200" step="0.5" class="w-full px-4 py-3 text-editorial-black bg-editorial-white border border-editorial-cream-dark focus:outline-none focus:ring-2 focus:ring-editorial-gold focus:border-editorial-gold transition-colors" />
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-editorial-gray mb-2">Busto (cm)</label>
                    <input type="number" id="m-bust" min="50" max="150" class="w-full px-4 py-3 text-editorial-black bg-editorial-white border border-editorial-cream-dark focus:outline-none focus:ring-2 focus:ring-editorial-gold focus:border-editorial-gold transition-colors" />
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-editorial-gray mb-2">Cintura (cm)</label>
                    <input type="number" id="m-waist" min="40" max="130" class="w-full px-4 py-3 text-editorial-black bg-editorial-white border border-editorial-cream-dark focus:outline-none focus:ring-2 focus:ring-editorial-gold focus:border-editorial-gold transition-colors" />
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-editorial-gray mb-2">Caderas (cm)</label>
                    <input type="number" id="m-hips" min="50" max="160" class="w-full px-4 py-3 text-editorial-black bg-editorial-white border border-editorial-cream-dark focus:outline-none focus:ring-2 focus:ring-editorial-gold focus:border-editorial-gold transition-colors" />
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-editorial-gray mb-2">Forma del cuerpo</label>
                    <select id="m-body-shape" class="w-full px-4 py-3 text-editorial-black bg-editorial-white border border-editorial-cream-dark focus:outline-none focus:ring-2 focus:ring-editorial-gold focus:border-editorial-gold transition-colors">
                      <option value="">Seleccionar</option>
                      <option value="hourglass">Reloj de arena</option>
                      <option value="pear">Pera</option>
                      <option value="apple">Manzana</option>
                      <option value="rectangle">Rectángulo</option>
                      <option value="inverted_triangle">Triángulo invertido</option>
                    </select>
                  </div>
                </div>
                <div class="flex justify-end gap-3 pt-4 border-t border-editorial-cream-dark">
                  <button id="btn-cancel-measurements" class="btn-secondary">Cancelar</button>
                  <button id="btn-save-measurements" class="btn-primary">Guardar medidas</button>
                </div>
              </div>

              <div id="tab-preferences" class="tab-content hidden space-y-6">
                <h3 class="font-display text-lg font-semibold text-editorial-black">Preferencias de estilo</h3>
                
                <div>
                  <label class="block text-sm font-medium text-editorial-gray mb-3">Estilos que te gustan</label>
                  <div class="flex flex-wrap gap-2" id="styles-tags">
                    {["Casual", "Elegante", "Boho", "Minimalista", "Streetwear", "Romántico", "Clásico", "Deportivo", "Vintage", "Moderno"].map(style => (
                      <button type="button" class="style-tag px-3 py-1.5 text-sm bg-editorial-cream-dark text-editorial-gray rounded-full hover:bg-editorial-gold hover:text-editorial-black transition-colors">{style}</button>
                    ))}
                  </div>
                </div>

                <div>
                  <label class="block text-sm font-medium text-editorial-gray mb-3">Colores favoritos</label>
                  <div class="flex flex-wrap gap-2" id="colors-tags">
                    {["Negro", "Blanco", "Azul", "Rojo", "Verde", "Rosa", "Beige", "Gris", "Marrón", "Mostaza", "Terracota", "Verde oliva"].map(color => (
                      <button type="button" class="color-tag px-3 py-1.5 text-sm bg-editorial-cream-dark text-editorial-gray rounded-full hover:bg-editorial-gold hover:text-editorial-black transition-colors">{color}</button>
                    ))}
                  </div>
                </div>

                <div>
                  <label class="block text-sm font-medium text-editorial-gray mb-3">Ocasiones de uso</label>
                  <div class="flex flex-wrap gap-2" id="occasions-tags">
                    {["Trabajo", "Casual diario", "Fiesta/Noche", "Cita", "Evento formal", "Deportes", "Playa/Vacaciones", "Hogar"].map(occ => (
                      <button type="button" class="occasion-tag px-3 py-1.5 text-sm bg-editorial-cream-dark text-editorial-gray rounded-full hover:bg-editorial-gold hover:text-editorial-black transition-colors">{occ}</button>
                    ))}
                  </div>
                </div>

                <div class="flex justify-end gap-3 pt-4 border-t border-editorial-cream-dark">
                  <button id="btn-cancel-preferences" class="btn-secondary">Cancelar</button>
                  <button id="btn-save-preferences" class="btn-primary">Guardar preferencias</button>
                </div>
              </div>

              <div id="tab-history" class="tab-content hidden">
                <div class="flex justify-between items-center mb-6">
                  <h3 class="font-display text-lg font-semibold text-editorial-black">Historial de pruebas virtuales</h3>
                </div>
                <div id="vton-history" class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-3">
                  <div class="col-span-full text-center py-12 text-editorial-gray">
                    <svg class="w-12 h-12 mx-auto mb-3 text-editorial-gray-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                    <p>No tienes historial aún</p>
                    <a href="/virtual-try-on" class="btn-primary mt-4 inline-block">Hacer mi primera prueba</a>
                  </div>
                </div>
              </div>

              <div id="tab-favorites" class="tab-content hidden">
                <div class="flex justify-between items-center mb-6">
                  <h3 class="font-display text-lg font-semibold text-editorial-black">Mis favoritos</h3>
                </div>
                <div id="favorites-grid" class="grid-auto-fit">
                  <div class="col-span-full text-center py-12 text-editorial-gray">
                    <svg class="w-12 h-12 mx-auto mb-3 text-editorial-gray-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
                    <p>No tienes favoritos aún</p>
                    <a href="/catalog" class="btn-primary mt-4 inline-block">Explorar catálogo</a>
                  </div>
                </div>
              </div>

              <div id="tab-subscription" class="tab-content hidden">
                <div class="max-w-2xl mx-auto">
                  <div class="text-center mb-8">
                    <h3 class="font-display text-2xl font-semibold text-editorial-black mb-2">Tu plan actual</h3>
                    <div id="current-plan" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-editorial-cream-dark text-editorial-gray text-sm font-medium">
                      Plan Free
                    </div>
                  </div>

                  <div class="grid md:grid-cols-2 gap-6 mb-8">
                    <div class="bg-editorial-white rounded-2xl border border-editorial-cream-dark p-6 relative">
                      <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-editorial-cream text-editorial-gray text-xs px-2 py-0.5 rounded">Actual</div>
                      <h4 class="font-display text-xl font-semibold text-editorial-black mb-2">Free</h4>
                      <p class="text-4xl font-display font-bold text-editorial-gray mb-1">Gratis</p>
                      <p class="text-editorial-gray-light mb-6">/ mes</p>
                      <ul class="space-y-3 mb-6">
                        <li class="flex items-center gap-2 text-editorial-gray"><svg class="w-5 h-5 text-editorial-gray-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg> 5 VTON/día</li>
                        <li class="flex items-center gap-2 text-editorial-gray"><svg class="w-5 h-5 text-editorial-gray-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg> 5 mensajes IA/día</li>
                        <li class="flex items-center gap-2 text-editorial-gray"><svg class="w-5 h-5 text-editorial-gray-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg> Acceso al catálogo completo</li>
                        <li class="flex items-center gap-2 text-editorial-gray"><svg class="w-5 h-5 text-editorial-gray-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg> Historial limitado</li>
                      </ul>
                      <button class="w-full btn-secondary" disabled>Plan actual</button>
                    </div>

                    <div class="bg-editorial-black rounded-2xl p-6 relative overflow-hidden">
                      <div class="absolute -top-3 right-1/2 -translate-x-1/2 bg-editorial-gold text-editorial-black text-xs px-2 py-0.5 rounded">Popular</div>
                      <div class="flex items-center justify-between mb-2">
                        <span class="text-editorial-gray-light text-sm">/ mes</span>
                        <span class="font-display text-4xl font-bold text-editorial-gold">CLP 4.990</span>
                      </div>
                      <h4 class="font-display text-xl font-semibold text-editorial-white mb-2">Premium</h4>
                      <p class="text-editorial-gray-light mb-6">Acceso ilimitado a todo</p>
                      <ul class="space-y-3 mb-6">
                        <li class="flex items-center gap-2 text-editorial-white"><svg class="w-5 h-5 text-editorial-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg> VTON ilimitados</li>
                        <li class="flex items-center gap-2 text-editorial-white"><svg class="w-5 h-5 text-editorial-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg> Mensajes IA ilimitados</li>
                        <li class="flex items-center gap-2 text-editorial-white"><svg class="w-5 h-5 text-editorial-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg> Asesor IA con razonamiento avanzado (DeepSeek R1)</li>
                        <li class="flex items-center gap-2 text-editorial-white"><svg class="w-5 h-5 text-editorial-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg> Historial completo</li>
                        <li class="flex items-center gap-2 text-editorial-white"><svg class="w-5 h-5 text-editorial-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg> Sin anuncios</li>
                      </ul>
                      <button id="btn-upgrade" class="w-full bg-editorial-gold text-editorial-black font-display font-medium py-3 rounded-none hover:bg-editorial-gold-light transition-colors">
                        Actualizar a Premium
                      </button>
                    </div>
                  </div>

                  <div class="bg-editorial-cream rounded-2xl border border-editorial-cream-dark p-6">
                    <h4 class="font-display text-lg font-semibold text-editorial-black mb-4">¿Cómo funciona?</h4>
                    <ol class="space-y-3 text-editorial-gray">
                      <li class="flex items-start gap-3"><span class="flex-shrink-0 w-6 h-6 bg-editorial-gold text-editorial-black rounded-full flex items-center justify-center text-xs font-bold">1</span> Elige Premium y paga con Transbank WebPay (tarjeta de débito/crédito)</li>
                      <li class="flex items-start gap-3"><span class="flex-shrink-0 w-6 h-6 bg-editorial-gold text-editorial-black rounded-full flex items-center justify-center text-xs font-bold">2</span> Tu cuenta se actualiza automáticamente en segundos</li>
                      <li class="flex items-start gap-3"><span class="flex-shrink-0 w-6 h-6 bg-editorial-gold text-editorial-black rounded-full flex items-center justify-center text-xs font-bold">3</span> Disfruta VTON e IA ilimitados al instante</li>
                      <li class="flex items-start gap-3"><span class="flex-shrink-0 w-6 h-6 bg-editorial-gold text-editorial-black rounded-full flex items-center justify-center text-xs font-bold">4</span> Cancela cuando quieras desde tu perfil, sin preguntas</li>
                    </ol>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>
  </div>
</Layout>

<script>
  const API_BASE = import.meta.env.PUBLIC_API_URL || 'https://api.thelineone.com/api/v1';

  // Tab switching
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('text-editorial-gold', 'border-editorial-gold');
        b.classList.add('text-editorial-gray', 'border-transparent');
      });
      btn.classList.remove('text-editorial-gray', 'border-transparent');
      btn.classList.add('text-editorial-gold', 'border-editorial-gold');

      document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
      document.getElementById('tab-' + btn.dataset.tab).classList.remove('hidden');
    });
  });

  // Style tags interaction
  document.querySelectorAll('.style-tag, .color-tag, .occasion-tag').forEach(tag => {
    tag.addEventListener('click', () => {
      tag.classList.toggle('bg-editorial-gold');
      tag.classList.toggle('text-editorial-black');
      tag.classList.toggle('bg-editorial-cream-dark');
      tag.classList.toggle('text-editorial-gray');
    });
  });

  // Load user data
  async function loadProfile() {
    try {
      const token = localStorage.getItem('token');
      if (!token) {
        window.location.href = '/login';
        return;
      }

      const response = await fetch(`${API_BASE}/users/me`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });

      if (response.ok) {
        const user = await response.json();
        document.getElementById('profile-name').textContent = user.name;
        document.getElementById('profile-email').textContent = user.email;
        document.getElementById('account-email').textContent = user.email;
        document.getElementById('account-plan').textContent = user.plan_type === 'premium' ? 'Premium' : 'Free';
        
        const planBadge = document.getElementById('plan-badge');
        if (user.plan_type === 'premium') {
          planBadge.textContent = 'Plan Premium';
          planBadge.className = 'px-3 py-1 text-xs font-medium rounded-full bg-editorial-gold/20 text-editorial-gold';
        }

        document.getElementById('input-name').value = user.name;
        document.getElementById('input-email').value = user.email;
        document.getElementById('input-gender').value = user.body_measurements?.gender || '';
        document.getElementById('input-age').value = user.age || '';

        // Load measurements
        if (user.body_measurements) {
          document.getElementById('m-height').value = user.body_measurements.height || '';
          document.getElementById('m-weight').value = user.body_measurements.weight || '';
          document.getElementById('m-bust').value = user.body_measurements.bust || '';
          document.getElementById('m-waist').value = user.body_measurements.waist || '';
          document.getElementById('m-hips').value = user.body_measurements.hips || '';
          document.getElementById('m-body-shape').value = user.body_measurements.bodyShape || '';
        }

        // Load preferences
        if (user.preferences) {
          const styles = user.preferences.styles || [];
          document.querySelectorAll('.style-tag').forEach(tag => {
            if (styles.includes(tag.textContent.trim())) {
              tag.classList.add('bg-editorial-gold', 'text-editorial-black');
              tag.classList.remove('bg-editorial-cream-dark', 'text-editorial-gray');
            }
          });

          const colors = user.preferences.colors || [];
          document.querySelectorAll('.color-tag').forEach(tag => {
            if (colors.includes(tag.textContent.trim())) {
              tag.classList.add('bg-editorial-gold', 'text-editorial-black');
              tag.classList.remove('bg-editorial-cream-dark', 'text-editorial-gray');
            }
          });

          const occasions = user.preferences.occasions || [];
          document.querySelectorAll('.occasion-tag').forEach(tag => {
            if (occasions.includes(tag.textContent.trim())) {
              tag.classList.add('bg-editorial-gold', 'text-editorial-black');
              tag.classList.remove('bg-editorial-cream-dark', 'text-editorial-gray');
            }
          });
        }

        // Load usage (only when profile loaded successfully)
        const today = new Date().toISOString().split('T')[0];
        const usageResponse = await fetch(`${API_BASE}/users/me/usage?date=${today}`, {
          headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
        });
        if (usageResponse.ok) {
          const usage = await usageResponse.json();
          const limitLabel = usage.limit === -1 ? '∞' : usage.limit;
          document.getElementById('usage-vton').textContent = `${usage.vton || 0}/${limitLabel}`;
          document.getElementById('usage-llm').textContent = `${usage.llm || 0}/${limitLabel}`;
        }
      } else if (response.status === 401) {
        localStorage.removeItem('token');
        localStorage.removeItem('refresh_token');
        window.location.href = '/login';
      }
    } catch (error) {
      console.error('Error loading profile:', error);
    }
  }

  loadProfile();

  // Tab switching
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('text-editorial-gold', 'border-editorial-gold');
        b.classList.add('text-editorial-gray', 'border-transparent');
      });
      btn.classList.remove('text-editorial-gray', 'border-transparent');
      btn.classList.add('text-editorial-gold', 'border-editorial-gold');

      document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
      document.getElementById('tab-' + btn.dataset.tab).classList.remove('hidden');
    });
  });

  // Style/color/occasion tag toggles
  document.querySelectorAll('.style-tag, .color-tag, .occasion-tag').forEach(tag => {
    tag.addEventListener('click', () => {
      tag.classList.toggle('bg-editorial-gold');
      tag.classList.toggle('text-editorial-black');
      tag.classList.toggle('bg-editorial-cream-dark');
      tag.classList.toggle('text-editorial-gray');
    });
  });

  // Save profile
  document.getElementById('btn-save-profile')?.addEventListener('click', async () => {
    const token = localStorage.getItem('token');
    const data = {
      name: document.getElementById('input-name').value,
      gender: document.getElementById('input-gender').value,
      age: parseInt(document.getElementById('input-age').value) || null
    };

    try {
      const response = await fetch(`${API_BASE}/users/profile`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${localStorage.getItem('token')}`
        },
        body: JSON.stringify(data)
      });
      if (response.ok) {
        alert('Perfil actualizado');
      } else {
        alert('Error al guardar');
      }
    } catch (error) {
      alert('Error de conexión');
    }
  });

  // Save measurements
  document.getElementById('btn-save-measurements')?.addEventListener('click', async () => {
    const token = localStorage.getItem('token');
    const data = {
      height: parseFloat(document.getElementById('m-height').value) || null,
      weight: parseFloat(document.getElementById('m-weight').value) || null,
      bust: parseFloat(document.getElementById('m-bust').value) || null,
      waist: parseFloat(document.getElementById('m-waist').value) || null,
      hips: parseFloat(document.getElementById('m-hips').value) || null,
      bodyShape: document.getElementById('m-body-shape').value || null
    };

    try {
      const response = await fetch(`${API_BASE}/users/measurements`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${localStorage.getItem('token')}`
        },
        body: JSON.stringify(data)
      });
      if (response.ok) {
        alert('Medidas guardadas');
      } else {
        alert('Error al guardar');
      }
    } catch (error) {
      alert('Error de conexión');
    }
  });

  // Save preferences
  document.getElementById('btn-save-preferences')?.addEventListener('click', async () => {
    const token = localStorage.getItem('token');
    const styles = Array.from(document.querySelectorAll('.style-tag.bg-editorial-gold')).map(t => t.textContent.trim());
    const colors = Array.from(document.querySelectorAll('.color-tag.bg-editorial-gold')).map(t => t.textContent.trim());
    const occasions = Array.from(document.querySelectorAll('.occasion-tag.bg-editorial-gold')).map(t => t.textContent.trim());

    try {
      const response = await fetch(`${API_BASE}/users/preferences`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${localStorage.getItem('token')}`
        },
        body: JSON.stringify({ preferences: { styles, colors, occasions } })
      });
      if (response.ok) {
        alert('Preferencias guardadas');
      } else {
        alert('Error al guardar');
      }
    } catch (error) {
      alert('Error de conexión');
    }
  });

  // Upgrade button
  document.getElementById('btn-upgrade')?.addEventListener('click', async () => {
    try {
      const response = await fetch(`${API_BASE}/payments/create`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${localStorage.getItem('token')}`
        },
        body: JSON.stringify({ plan_type: 'premium' })
      });
      const result = await response.json();
      if (response.ok && result.url) {
        window.location.href = result.url;
      } else {
        alert(result.detail || 'Error al crear pago');
      }
    } catch (error) {
      alert('Error de conexión');
    }
  });
</script>