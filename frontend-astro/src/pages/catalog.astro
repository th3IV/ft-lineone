---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Catálogo - FT. THE LINE ONE">
  <div class="min-h-screen bg-editorial-cream">
    <!-- Header with Filters -->
    <header class="bg-editorial-white border-b border-editorial-cream-dark sticky top-0 z-40">
      <div class="container-main py-4">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <h1 class="font-display text-2xl font-semibold text-editorial-black">Catálogo</h1>
          <div class="flex flex-wrap gap-2">
            <a href="/virtual-try-on" class="btn-secondary text-sm px-4 py-2">
              Probar VTON
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Filters Sidebar + Products Grid -->
    <div class="container-main py-8">
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Filters Sidebar -->
        <aside class="lg:w-64 flex-shrink-0">
          <div class="bg-editorial-white rounded-2xl border border-editorial-cream-dark p-6 sticky top-24 h-fit">
            <h3 class="font-display text-lg font-semibold text-editorial-black mb-6 pb-3 border-b border-editorial-cream-dark">
              Filtros
            </h3>
            
            <div class="space-y-6">
              <!-- Search -->
              <div>
                <label class="block text-sm font-medium text-editorial-gray mb-2">
                  Buscar
                </label>
                <input
                  type="text"
                  id="filter-search"
                  placeholder="Buscar productos..."
                  class="w-full px-3 py-2 text-editorial-black bg-editorial-white border border-editorial-cream-dark focus:outline-none focus:ring-2 focus:ring-editorial-gold focus:border-editorial-gold transition-colors"
                />
              </div>

              <!-- Stores -->
              <div>
                <label class="block text-sm font-medium text-editorial-gray mb-2">
                  Tiendas
                </label>
                <div class="space-y-2" id="filter-stores">
                  {["Zara", "Paris", "Falabella", "H&M", "Maui", "FashionPark", "Ripley"].map((store) => (
                    <label class="flex items-center gap-2 cursor-pointer">
                      <input type="checkbox" value={store.toLowerCase()} class="filter-store w-4 h-4 text-editorial-gold border-editorial-cream-dark rounded focus:ring-editorial-gold" />
                      <span class="text-sm text-editorial-black">{store}</span>
                    </label>
                  ))}
                </div>
              </div>

              <!-- Categories -->
              <div>
                <label class="block text-sm font-medium text-editorial-gray mb-2">
                  Categorías
                </label>
                <div class="space-y-2" id="filter-categories">
                  {["Poleras", "Camisas", "Pantalones", "Jeans", "Shorts", "Chaquetas", "Vestidos", "Faldas", "Polerones"].map((cat) => (
                    <label class="flex items-center gap-2 cursor-pointer">
                      <input type="checkbox" value={cat.toLowerCase()} class="filter-category w-4 h-4 text-editorial-gold border-editorial-cream-dark rounded focus:ring-editorial-gold" />
                      <span class="text-sm text-editorial-black">{cat}</span>
                    </label>
                  ))}
                </div>
              </div>

              <!-- Price Range -->
              <div>
                <label class="block text-sm font-medium text-editorial-gray mb-2">
                  Rango de Precio
                </label>
                <div class="flex items-center gap-2">
                  <input
                    type="number"
                    id="filter-price-min"
                    placeholder="Mín"
                    class="w-full px-3 py-2 text-sm text-editorial-black bg-editorial-white border border-editorial-cream-dark focus:outline-none focus:ring-2 focus:ring-editorial-gold"
                  />
                  <span class="text-editorial-gray">-</span>
                  <input
                    type="number"
                    id="filter-price-max"
                    placeholder="Máx"
                    class="w-full px-3 py-2 text-sm text-editorial-black bg-editorial-white border border-editorial-cream-dark focus:outline-none focus:ring-2 focus:ring-editorial-gold"
                  />
                </div>
              </div>

              <!-- Sort -->
              <div>
                <label class="block text-sm font-medium text-editorial-gray mb-2">
                  Ordenar por
                </label>
                <select id="filter-sort" class="w-full px-3 py-2 text-sm text-editorial-black bg-editorial-white border border-editorial-cream-dark focus:outline-none focus:ring-2 focus:ring-editorial-gold">
                  <option value="newest">Más recientes</option>
                  <option value="price_asc">Precio: Menor a Mayor</option>
                  <option value="price_desc">Precio: Mayor a Menor</option>
                </select>
              </div>

              <button id="filter-clear" class="w-full mt-6 btn-secondary">
                Limpiar Filtros
              </button>
            </div>
          </div>
        </aside>

        <!-- Products Grid -->
        <main class="flex-1">
          <div class="flex items-center justify-between mb-6">
            <div class="text-sm text-editorial-gray">
              <span id="products-count">0</span> productos encontrados
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="products-grid">
            <!-- Loading skeleton -->
            <div class="col-span-full flex flex-col items-center justify-center py-16">
              <div class="loader mb-4"></div>
              <p class="text-editorial-gray">Cargando productos...</p>
            </div>
          </div>

          <!-- Pagination -->
          <div class="flex justify-center gap-2 mt-8" id="pagination"></div>
        </main>
      </div>
    </div>
  </div>
</Layout>

<script>
  const API_BASE = import.meta.env.PUBLIC_API_URL || 'https://api.thelineone.com/api/v1';
  
  let currentPage = 1;
  const limit = 20;
  let currentFilters: Record<string, string> = {};

  function getActiveFilters() {
    const stores = Array.from(document.querySelectorAll('.filter-store:checked')).map((el: any) => el.value);
    const categories = Array.from(document.querySelectorAll('.filter-category:checked')).map((el: any) => el.value);
    const search = (document.getElementById('filter-search') as HTMLInputElement)?.value || '';
    const minPrice = (document.getElementById('filter-price-min') as HTMLInputElement)?.value || '';
    const maxPrice = (document.getElementById('filter-price-max') as HTMLInputElement)?.value || '';
    const sort = (document.getElementById('filter-sort') as HTMLSelectElement)?.value || 'newest';

    return { stores, categories, search, minPrice, maxPrice, sort };
  }

  async function loadProducts(page = 1) {
    const grid = document.getElementById('products-grid');
    const countEl = document.getElementById('products-count');
    if (!grid) return;

    grid.innerHTML = '<div class="col-span-full flex flex-col items-center justify-center py-16"><div class="loader mb-4"></div><p class="text-editorial-gray">Cargando productos...</p></div>';

    try {
      const filters = getActiveFilters();
      const params = new URLSearchParams();
      params.append('page', page.toString());
      params.append('limit', limit.toString());
      if (filters.search) params.append('query', filters.search);
      if (filters.stores.length === 1) params.append('store', filters.stores[0]);
      if (filters.categories.length === 1) params.append('category', filters.categories[0]);
      if (filters.minPrice) params.append('min_price', filters.minPrice);
      if (filters.maxPrice) params.append('max_price', filters.maxPrice);
      if (filters.sort) params.append('sort', filters.sort);

      const response = await fetch(`${API_BASE}/products?${params.toString()}`);
      if (!response.ok) throw new Error('Failed to fetch');
      const data = await response.json();

      const products = data.products || [];
      const total = data.total || 0;
      currentPage = page;

      if (countEl) countEl.textContent = total.toString();

      if (products.length === 0) {
        grid.innerHTML = '<div class="col-span-full flex flex-col items-center justify-center py-16"><p class="text-editorial-gray text-lg">No se encontraron productos</p><p class="text-editorial-gray text-sm mt-2">Intenta ajustar los filtros</p></div>';
        return;
      }

      grid.innerHTML = products.map((p: any) => `
        <a href="${p.original_url || '#'}" target="_blank" rel="noopener noreferrer"
           class="group bg-editorial-white rounded-2xl border border-editorial-cream-dark overflow-hidden hover:shadow-lg transition-all duration-300">
          <div class="aspect-[3/4] overflow-hidden bg-editorial-cream-dark">
            <img src="${p.image_url || p.image_urls?.[0] || '/placeholder.png'}" 
                 alt="${p.name}" 
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                 loading="lazy" />
          </div>
          <div class="p-4">
            <p class="text-xs text-editorial-gray uppercase tracking-wider mb-1">${p.store}</p>
            <h3 class="font-display text-sm font-medium text-editorial-black line-clamp-2 mb-2">${p.name}</h3>
            <div class="flex items-center justify-between">
              <span class="font-display font-semibold text-editorial-black">${p.currency === 'CLP' ? '$' : ''}${p.price?.toLocaleString('es-CL') || '—'}</span>
              <a href="/virtual-try-on" class="text-xs text-editorial-gold hover:underline">Probar →</a>
            </div>
          </div>
        </a>
      `).join('');

      renderPagination(total, page);
    } catch (err) {
      grid.innerHTML = '<div class="col-span-full flex flex-col items-center justify-center py-16"><p class="text-editorial-gray">Error al cargar productos</p></div>';
    }
  }

  function renderPagination(total: number, page: number) {
    const pag = document.getElementById('pagination');
    if (!pag) return;
    const totalPages = Math.ceil(total / limit);
    if (totalPages <= 1) { pag.innerHTML = ''; return; }

    let html = '';
    if (page > 1) html += `<button class="page-btn px-3 py-2 text-sm border border-editorial-cream-dark rounded-lg hover:bg-editorial-cream-dark" data-page="${page - 1}">← Anterior</button>`;
    for (let i = Math.max(1, page - 2); i <= Math.min(totalPages, page + 2); i++) {
      html += `<button class="page-btn px-3 py-2 text-sm border rounded-lg ${i === page ? 'bg-editorial-black text-white border-editorial-black' : 'border-editorial-cream-dark hover:bg-editorial-cream-dark'}" data-page="${i}">${i}</button>`;
    }
    if (page < totalPages) html += `<button class="page-btn px-3 py-2 text-sm border border-editorial-cream-dark rounded-lg hover:bg-editorial-cream-dark" data-page="${page + 1}">Siguiente →</button>`;
    pag.innerHTML = html;

    pag.querySelectorAll('.page-btn').forEach((btn) => {
      btn.addEventListener('click', () => loadProducts(parseInt((btn as HTMLElement).dataset.page || '1')));
    });
  }

  // Filter event listeners
  document.querySelectorAll('.filter-store, .filter-category').forEach((el) => {
    el.addEventListener('change', () => loadProducts(1));
  });

  let searchTimeout: ReturnType<typeof setTimeout>;
  document.getElementById('filter-search')?.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => loadProducts(1), 300);
  });

  document.getElementById('filter-sort')?.addEventListener('change', () => loadProducts(1));
  document.getElementById('filter-clear')?.addEventListener('click', () => {
    document.querySelectorAll('.filter-store, .filter-category').forEach((el: any) => el.checked = false);
    const searchEl = document.getElementById('filter-search') as HTMLInputElement;
    if (searchEl) searchEl.value = '';
    const minEl = document.getElementById('filter-price-min') as HTMLInputElement;
    if (minEl) minEl.value = '';
    const maxEl = document.getElementById('filter-price-max') as HTMLInputElement;
    if (maxEl) maxEl.value = '';
    const sortEl = document.getElementById('filter-sort') as HTMLSelectElement;
    if (sortEl) sortEl.value = 'newest';
    loadProducts(1);
  });

  // Initial load
  loadProducts(1);
</script>
