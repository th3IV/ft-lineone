---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const { title = "FT. THE LINE ONE", description = "Fashion Tech Platform - Virtual Try-On & AI Recommendations" } = Astro.props
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="min-h-screen bg-editorial-cream font-body antialiased">
    <slot />
    
    <!-- Global toast container -->
    <div id="toast-root" class="fixed bottom-6 right-6 z-[100] flex flex-col gap-3 pointer-events-none"></div>
    
    <!-- Global modal root -->
    <div id="modal-root" class="fixed inset-0 z-[200] pointer-events-none"></div>
  </body>
</html>